# Optional environment overrides read by the scripts (copy the lines you need into your shell
# or ~/.bashrc; nothing reads a .env file automatically). Defaults are in brackets.

# Hugging Face organization the datasets and models go to [cleany-ai]
HF_NAMESPACE=cleany-ai
# Physical setup name, part of every uploaded model's name [setupv2]
SETUP_NAME=setupv2

# Models for scripts/run/run_pipeline.sh [from config/default.yaml]
# PLASTIC_MODEL=cleany-ai/setupv2_act_plastic_20261020_1926
# METAL_MODEL=cleany-ai/setupv2_act_metal_20261021_1855
# YOLO_MODEL=/path/to/best.pt

# Rerun viewer while recording / running [true]
DISPLAY_DATA=true

# Never let Ultralytics install packages: it would replace LeRobot's OpenCV [false]
YOLO_AUTOINSTALL=false

# The Hugging Face token is stored by `.venv/bin/hf auth login`; never put it in a file in git.
